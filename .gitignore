# ============================================================
# Flowtaris Ecosystem — .gitignore
# ============================================================

# ── Dependencies ─────────────────────────────────────────────
node_modules/
.pnp
.pnp.js

# ── Environment & Secrets (NEVER commit these) ────────────────
.env
.env.local
.env.*.local
.env.development
.env.test
.env.production
.env.staging
*.env

# ── Build Outputs ─────────────────────────────────────────────
.next/
out/
build/
dist/
.turbo/

# ── Vercel ────────────────────────────────────────────────────
.vercel/

# ── Supabase local dev ────────────────────────────────────────
supabase/.branches/
supabase/.temp/

# ── Temp / scratch SQL dumps (contain real data) ─────────────
temp*.sql
temp_*.sql
*_dump.sql

# ── Testing & Coverage ────────────────────────────────────────
coverage/

# ── Debug logs ────────────────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── Storybook ─────────────────────────────────────────────────
*storybook.log
storybook-static/

# ── OS / Editor ───────────────────────────────────────────────
.DS_Store
Thumbs.db
*.pem
.idea/
.vscode/settings.json

# ── Certificates ──────────────────────────────────────────────
*.key
*.cert
*.crt
