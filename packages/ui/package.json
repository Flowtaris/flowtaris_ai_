    "@types/node": "^22.15.3",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitest/browser-playwright": "latest",
    "@vitest/coverage-v8": "latest",
    "eslint": "^9.39.1",
    "eslint-plugin-storybook": "^10.6.0",
    "playwright": "latest",
    "storybook": "^10.6.0",
    "typescript": "5.9.2",
    "vitest": "latest"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^2.12.7",
    "tailwind-merge": "^3.6.0",
    "zod": "^3.25.76"
  }
